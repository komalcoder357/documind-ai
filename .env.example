# Copy to .env (never commit .env). Placeholders only.
POSTGRES_PASSWORD=change-me
DATABASE_URL=sqlite:///./documind.db        # local dev; use postgresql+psycopg://... in production
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10000000
MAX_PAGES=300
COOKIE_SECURE=false                         # true behind HTTPS
CORS_ORIGINS=http://localhost:5173
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your-gemini-api-key-here
EMBED_PROVIDER=hash                         # hash | sbert (needs sentence-transformers)
GITHUB_TOKEN=                               # optional, raises GitHub API rate limit
# Dev only:
JOBS_SYNC=false
AUTO_CREATE_TABLES=false
DEV_RETURN_RESET_TOKEN=false

# to run .\run.bat
